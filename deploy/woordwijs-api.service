[Unit]
Description=Woordwijs read-only dictionary API
After=network.target
[Service]
User=woordwijs
Group=woordwijs
Environment=WOORDWIJS_DB=/var/lib/woordwijs/databases/dictionary.sqlite
ExecStart=/usr/bin/python3 /var/lib/woordwijs/current/backend/server.py
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
MemoryMax=256M
[Install]
WantedBy=multi-user.target
